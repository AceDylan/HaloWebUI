# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''
# Prefer importing your custom CA certificate into the container trust store.
# Set the following to false only as a temporary compatibility workaround.
REQUESTS_VERIFY=true
AIOHTTP_CLIENT_SESSION_SSL=true

# Anthropic (Claude) - optional. You can also configure via Admin -> Settings -> Connections.
ENABLE_ANTHROPIC_API=false
ANTHROPIC_API_BASE_URL='https://api.anthropic.com/v1'
ANTHROPIC_API_KEY=''

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Legacy compatibility key retained for existing deployments. Its value no
# longer disables the required AGY attempt for server-confirmed Web Chat.
HALOWEBUI_AGY_ENABLED=true
# The command is parsed as argv, then receives the design request as the final
# argument; it is never run through a shell. The default keeps AGY sandboxed and
# disables slash-command expansion because the request contains untrusted text.
# Missing/failed/timed-out/invalid AGY explicitly hands design and validation
# back to the main model.
HALOWEBUI_AGY_COMMAND='agy --sandbox --disable-slash-commands -p'
HALOWEBUI_AGY_TIMEOUT_SECONDS=30
# Create each design pass's isolated temporary working directory under this path.
HALOWEBUI_AGY_WORKDIR='/tmp'
# Optional AGY OAuth Docker secret. Do not paste token contents into this file or
# mount the whole host .gemini directory. The opt-in compose override maps the
# secret to the backend-only path below; each AGY run copies it into its
# ephemeral HOME with mode 0600 and removes that HOME afterward.
# HALOWEBUI_AGY_OAUTH_TOKEN_HOST_FILE='/root/.gemini/antigravity-cli/antigravity-oauth-token'
# HALOWEBUI_AGY_OAUTH_TOKEN_FILE='/run/secrets/halowebui_agy_oauth_token'
# Activate with:
# HALOWEBUI_AGY_OAUTH_TOKEN_HOST_FILE=/root/.gemini/antigravity-cli/antigravity-oauth-token docker compose -f docker-compose.yaml -f docker-compose.agy-oauth.yaml up -d
